SERVER_PORT=8086

# Nœud Bitcoin Core (un nœud par réseau, voir BITCOIN_NETWORK)
BITCOIN_RPC_HOST=
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
# Wallet watch-only (descripteurs, sans clé privée), créé au démarrage s'il n'existe pas ; un par environnement
BITCOIN_RPC_WALLET=bitcoin-service

# main | testnet4 | regtest
BITCOIN_NETWORK=regtest

# Clé publique étendue de réception (xpub/zpub en main, tpub/vpub en testnet4 et regtest). Aucune clé privée.
XPUB=

# Secret de l'en-tête X-Api-Key des routes /v1 (32 caractères minimum)
API_TOKEN=

# Postgres (dev : conteneur postgres:16-alpine du docker-compose.yaml)
DATABASE_URL=postgresql://bitcoin:bitcoin@localhost:5432/bitcoin_service

# En Swarm, chaque secret peut venir d'un fichier : <VAR>_FILE=/run/secrets/<nom>
# (DATABASE_URL, API_TOKEN, BITCOIN_RPC_PASSWORD), voir docker/entrypoint.sh

# Confirmations avant notification du shop (même seuil pour toutes les factures)
MIN_CONFIRMATIONS=3
SCAN_INTERVAL_SECONDS=15
# Les sorties de ce montant (sats) ou moins sont enregistrées mais jamais notifiées
DUST_SATS=1000

LOG_LEVEL=DEBUG
